{
  "monitoring": {
    "enabled": false,
    "intervalSeconds": 60,
    "maxConsecutiveFailures": 3,
    "alertOnRecovery": true,
    "alertOnDataQualityChanges": true,
    "alertOnEveryCriticalCheck": false,
    "criticalReminderSeconds": null
  },
  "storage": {
    "path": "data/watchdog.sqlite",
    "cycleRetentionDays": 30,
    "alertRetentionDays": 180
  },
  "notifications": {
    "telegram": false,
    "discord": false,
    "maxAttempts": 5,
    "baseDelaySeconds": 5,
    "maxDelaySeconds": 900,
    "jitterRatio": 0.2,
    "timeoutSeconds": 15,
    "maxPerDrain": 10
  },
  "operations": {
    "profile": "local",
    "shutdownTimeoutSeconds": 30,
    "cycleTimeoutSeconds": 240,
    "connectivityTimeoutSeconds": 30,
    "chainStatusMaxAgeSeconds": 600,
    "failureBackoffMaxSeconds": 900
  },
  "resources": {
    "databaseBytes": 4294967296,
    "walBytes": 268435456,
    "minFreeBytes": 536870912,
    "pendingDeliveries": 10000,
    "rssBytes": 536870912,
    "evidenceBytes": 2147483648,
    "evidenceFiles": 50000
  }
}
