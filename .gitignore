# Local dependencies, generated output and private runtime state.
node_modules/
dist/
coverage/
.env
.env.*
!.env.example
*.log
*.tsbuildinfo
data/
*.sqlite
*.sqlite-*
*.db
*.db-*
watchdog.config.json
backups/

# Local credentials and tool configuration; no usable credentials belong here.
.git/
opencode.jsonc
.npmrc
.netrc
.pypirc
.aws/
.ssh/
credentials.json
credentials.*
wallet.json
keypair.json
id_rsa
id_ed25519
*.pem
*.key
*.p12
*.pfx

# Active caches, locks and temporary output. Historical capsule bytes are retained.
.cache/
.vite/
.wrangler/
__pycache__/
.pytest_cache/
*.py[cod]
*.pid
*.lock
/tmp/
/temp/
/tsx-*/

